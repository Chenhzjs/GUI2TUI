FROM rust:1.88-bookworm AS rust-toolchain

FROM ubuntu:22.04

COPY --from=rust-toolchain /usr/local/cargo /usr/local/cargo
COPY --from=rust-toolchain /usr/local/rustup /usr/local/rustup

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH=/usr/local/cargo/bin:$PATH

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        at-spi2-core \
        binutils \
        build-essential \
        ca-certificates \
        dbus-x11 \
        file \
        gir1.2-gtk-3.0 \
        gir1.2-gtk-4.0 \
        git \
        jq \
        libglib2.0-bin \
        locales \
        procps \
        python3 \
        python3-gi \
        python3-pexpect \
        python3-pyqt5 \
        python3-pyte \
        util-linux \
        x11-utils \
        xvfb \
    && rm -rf /var/lib/apt/lists/* \
    && locale-gen C.UTF-8

ENV LANG=C.UTF-8 \
    TERM=xterm-256color

ARG QUALIFIER_UID=1000
RUN if ! getent passwd "$QUALIFIER_UID" >/dev/null; then \
        useradd --uid "$QUALIFIER_UID" --no-create-home --shell /bin/bash qualifier; \
    fi

WORKDIR /src
